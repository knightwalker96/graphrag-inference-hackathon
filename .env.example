# Copy this file to .env and fill in your values
# cp .env.example .env

# Answering LLM backend — "ollama" (local, free) or "openai" (paid API).
# Can also be overridden per-run via the CLI: `python main.py ... --llm openai`.
LLM_PROVIDER=ollama

# Ollama model — must be pulled first: ollama pull llama3.1
OLLAMA_MODEL=llama3.1

# OpenAI — only needed if LLM_PROVIDER=openai (or --llm openai at CLI).
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evaluation judge — "hf" uses Hugging Face API (requires token below)
# Set to "ollama" to judge locally (no token needed, but biased if same model runs the pipeline)
JUDGE_PROVIDER=hf

# Required if JUDGE_PROVIDER=hf
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- TigerGraph Savanna (Pipeline 3: GraphRAG) ---
# Create a free workspace at https://tgcloud.io, then fill these from the workspace.
# HOST must include https:// and have no trailing path.
TIGERGRAPH_HOST=https://<your-id>.i.tgcloud.io
TIGERGRAPH_GRAPH=bioasq
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=

# --- Google Gemini (knowledge-graph entity/relationship extraction) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
