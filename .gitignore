# Virtual environment
.venv/

# Secrets — NEVER commit
.env

# Data artifacts (large; regenerated by the build scripts — see README)
#   build_corpus.py              -> chroma_db_<dataset>/   (Pipeline 2 vector index)
#   build_entity_index_gemini.py -> pipeline3_<dataset>/index/  (Gemini knowledge graph)
chroma_db/
chroma_db_*/
pipeline3_gemini/
.trash_results/

# KG index: ship the files the hosted app needs for Pipeline 3 (skip the big corpus.json dup)
pipeline3_bioasq/*
!pipeline3_bioasq/index/
pipeline3_bioasq/index/*
!pipeline3_bioasq/index/doc_content.json
!pipeline3_bioasq/index/entity_to_docs.json
!pipeline3_bioasq/index/entity_types.json
!pipeline3_bioasq/index/relationships.json

# Separate all-datasets archive + backups (kept locally, not committed)
*.zip
archive_all_datasets.zip
backups/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# macOS
.DS_Store

# Claude local settings
.claude/settings.local.json

# Logs / tmp
*.log
results/*.log
/tmp/

# Claude Code tooling (local only)
.claude/
CLAUDE.md

# Not for public repo — only the final benchmark_results.json is shown
results/*
!results/benchmark_results.json
SUBMISSION_RESULTS.md
PROBLEM_STATEMENT.md
# Team-only presentation docs (contain dataset token sizes — keep out of public repo)
PROJECT_DOSSIER.md
PRESENTATION_DECK.md
QUIZ.md
